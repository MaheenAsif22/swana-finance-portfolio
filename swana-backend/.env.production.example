NODE_ENV=production
PORT=3001

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-string
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed frontend origins (no trailing slash)
# Add your Vercel/Netlify URL and any custom domain
ALLOWED_ORIGINS=https://swana-finance.vercel.app,https://yourdomain.com
